import re
def remove_urls(text):
    text = re.sub(r"http\S+" , "", text)  
    return text
    
df["review"] = df["review"].apply(remove_urls)              # Removing URL from the text

def remove_punctuation(text):
    text = re.sub(r"[^A-Za-z0-9\s]", "", text)
    return text
df["review"] = df["review"].apply(remove_punctuation)        # Removing Punctuation from the text

