# Importing Basic Libraries 

Import pandas as Pd 
import numpy as np

# loading the dataset
df = pd.read_csv("IMDB Dataset.csv")

df.isnull().sum()
df.drop_duplicates(inplace=True)

# Data PreProcessing

df["review"] = df["review"].str.lower()    # Converting all text to lowercase

import re
def remove_urls(text):
    text = re.sub(r"http\S+" , "", text)  
    return text
    
df["review"] = df["review"].apply(remove_urls)              # Removing URL from the text

def remove_punctuation(text):
    text = re.sub(r"[^A-Za-z0-9\s]", "", text)
    return text
df["review"] = df["review"].apply(remove_punctuation)        # Removing Punctuation from the text